{
  "FileVersion": 3,
  "Version": 2,
  "VersionName": "0.1.1",
  "FriendlyName": "OpenPocketBase SDK",
  "Description": "PocketBase v0.39.11 client for Unreal Engine C++ and Blueprint projects.",
  "Category": "Online",
  "CreatedBy": "Ishtmeet Singh",
  "CreatedByURL": "https://github.com/ishtms",
  "DocsURL": "https://github.com/ishtms/OpenPocketBaseSDK",
  "SupportURL": "https://github.com/ishtms/OpenPocketBaseSDK/issues",
  "EngineVersion": "5.8.0",
  "CanContainContent": false,
  "Installed": false,
  "Plugins": [
    {
      "Name": "DataValidation",
      "Enabled": true
    }
  ],
  "Modules": [
    {
      "Name": "OpenPocketBaseSDK",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": [
        "Win64",
        "Mac"
      ]
    },
    {
      "Name": "OpenPocketBaseSDKOffline",
      "Type": "Runtime",
      "LoadingPhase": "None",
      "PlatformAllowList": [
        "Win64",
        "Mac"
      ]
    },
    {
      "Name": "OpenPocketBaseSDKAdmin",
      "Type": "Runtime",
      "LoadingPhase": "None",
      "PlatformAllowList": [
        "Win64",
        "Mac"
      ],
      "TargetConfigurationDenyList": [
        "Shipping"
      ]
    },
    {
      "Name": "OpenPocketBaseSDKEditor",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "PlatformAllowList": [
        "Win64",
        "Mac"
      ]
    },
    {
      "Name": "OpenPocketBaseSDKTests",
      "Type": "DeveloperTool",
      "LoadingPhase": "PostDefault",
      "PlatformAllowList": [
        "Win64",
        "Mac"
      ],
      "TargetAllowList": [
        "Editor"
      ]
    },
    {
      "Name": "OpenPocketBaseSDKPublicHeaders",
      "Type": "DeveloperTool",
      "LoadingPhase": "None",
      "PlatformAllowList": [
        "Win64",
        "Mac"
      ],
      "TargetAllowList": [
        "Editor"
      ]
    }
  ]
}
